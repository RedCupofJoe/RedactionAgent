# MinIO / S3
S3_ENDPOINT_URL=http://minio.minio.svc.cluster.local:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_RAW_BUCKET=raw-documents
S3_REDACTED_BUCKET=redacted-documents
S3_SECURE=false

# Qdrant
QDRANT_URL=http://qdrant.qdrant.svc.cluster.local:6333
QDRANT_COLLECTION=redaction-events
QDRANT_API_KEY=

# Embedding model (local sentence-transformers or RHOAI endpoint)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# RHOAI / vLLM SLM endpoint (OpenAI-compatible)
LLM_BASE_URL=https://granite-predictor-rhoai-models.apps.example.com/v1
LLM_API_KEY=unused
LLM_MODEL=ibm-granite/granite-3.2-8b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# MCP Gateway
MCP_GATEWAY_URL=http://mcp-gateway.mcp-gateway.svc.cluster.local:8080
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080

# Agent / API
AGENT_API_URL=http://redaction-agent.redaction-agent.svc.cluster.local:8000
LOG_LEVEL=INFO
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EVENT_TOP_K=8
EVENT_SCORE_THRESHOLD=0.55
