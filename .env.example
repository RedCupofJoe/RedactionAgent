# MinIO / S3
# RESERVED bucket names for this agent (other agents: use different buckets):
#   raw-documents, redacted-documents, vector-index
S3_ENDPOINT_URL=http://minio.minio.svc.cluster.local:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_RAW_BUCKET=raw-documents
S3_REDACTED_BUCKET=redacted-documents
S3_VECTOR_BUCKET=vector-index
S3_SECURE=false

# Vector index prefix inside MinIO (not Qdrant / external DB)
VECTOR_COLLECTION=redaction-events

# Embeddings — OpenShift AI catalog InferenceService (OpenAI-compatible)
# Use local:// for offline demos/tests without a catalog embedder
EMBEDDING_BASE_URL=http://lab-embed-predictor.rhoai-models.svc.cluster.local:80/v1
EMBEDDING_API_KEY=unused
EMBEDDING_MODEL=REPLACE_WITH_CATALOG_EMBEDDING_MODEL_ID
EMBEDDING_DIM=384

# Chat SLM — OpenShift AI catalog InferenceService (OpenAI-compatible)
LLM_BASE_URL=http://lab-slm-predictor.rhoai-models.svc.cluster.local:80/v1
LLM_API_KEY=unused
LLM_MODEL=REPLACE_WITH_CATALOG_MODEL_ID
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# MCP Gateway
MCP_GATEWAY_URL=http://mcp-gateway.mcp-gateway.svc.cluster.local:8080
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080

# Agent / API
AGENT_API_URL=http://redaction-agent.redaction-agent.svc.cluster.local:8000
LOG_LEVEL=INFO
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EVENT_TOP_K=8
EVENT_SCORE_THRESHOLD=0.55
